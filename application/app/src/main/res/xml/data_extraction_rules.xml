<?xml version="1.0" encoding="utf-8"?>
<!--
   クラウド (Google のバックアップ) には、データフォルダ (外部ストレージの Documents/CycleMap) を送らない。
   - gpx/ は走行記録 = 位置の履歴。本人の操作なしに端末の外へ出さない
   - 地図・経路・検索のデータは数百 MB あり、入れ直せる。バックアップの上限 (25 MB) を超えて全体が失敗する原因にもなる
   機種変更のときの端末どうしの転送 (device-transfer) は既定のまま (記録も引き継ぐ)。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="Documents/CycleMap" />
    </cloud-backup>
</data-extraction-rules>
